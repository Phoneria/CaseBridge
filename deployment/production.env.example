# Template for /etc/casebridge/production.env on the server. NEVER commit the real file.
# Copy it to the server, fill every <...> value and keep the file mode 600.
# Generate each secret separately with:  openssl rand -hex 32

# --- Database (used once when the volume is first created; changing it later does not change the DB password)
POSTGRES_PASSWORD=<openssl rand -hex 32>

# --- Sessions
JWT_SECRET=<a different openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Environment (compose also forces ENV=production and SEED_DEMO_DATA=false)
ENV=production
SEED_DEMO_DATA=false

# --- Public address: invite / reset links and reminder e-mails point here
APP_BASE_URL=https://app.casebridge.com.tr
FRONTEND_BASE_URL=https://app.casebridge.com.tr
EXTRA_CORS_ORIGINS=https://app.casebridge.com.tr
APP_TIMEZONE=Europe/Istanbul

# --- CaseBridge team: platform admins created (and invited by e-mail) on startup.
# Use addresses that are NOT used in any firm. Comma-separated.
PLATFORM_ADMIN_EMAILS=<ops@your-domain>

# --- E-mail (invites, password resets, reminders). STARTTLS on port 587;
# implicit-TLS port 465 is not supported.
EMAIL_BACKEND=smtp
SMTP_HOST=<smtp.provider.example>
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=<smtp user>
SMTP_PASSWORD=<smtp password>
SMTP_FROM=CaseBridge <no-reply@casebridge.com.tr>
REMINDERS_ENABLED=true

# --- AI: OpenAI for analysis, courtroom, "Belgeden doldur" and the chat assistant.
# Check that the models below are available on your OpenAI account; set a spending limit there.
LLM_PROVIDER=openai
OPENAI_API_KEY=<sk-...>
OPENAI_MODEL=gpt-4o-mini
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
# Monthly token budget shown in the sidebar (0 = no budget shown).
AI_MONTHLY_TOKEN_BUDGET=0
