# AI provider selection - explicit and required. One of: qwen | openai | ollama | mock
# "mock" (default-safe) never calls a real provider or spends credits.
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Qwen3-32B via the OpenAI-compatible Alibaba Model Studio (DashScope) API.
# QWEN_BASE_URL differs by region/workspace - copy it from your Model
# Studio console, do not assume a default.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3-32b
QWEN_ENABLE_THINKING=false
QWEN_TIMEOUT_SECONDS=90
QWEN_MAX_OUTPUT_TOKENS=8192

# Local Ollama. For a backend started directly on the host, keep
# 127.0.0.1. Docker Compose overrides this with host.docker.internal.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=16384

# Analysis/courtroom levels: Standart = the provider's model above.
# Basit is used for interim judge feedback and JSON repair; Kapsamlı for the
# analysis judge and the final courtroom verdict. Empty -> Standart model.
LLM_MODEL_BASIC=
LLM_MODEL_DEEP=

# Chat assistant (Hukuk Asistanı) - independent of LLM_PROVIDER.
# CHAT_PROVIDER: openai | ollama | mock. For an OpenAI fine-tune set
# CHAT_MODEL=ft:gpt-4o-mini:<org>::<id>; for a local fine-tune use
# CHAT_PROVIDER=ollama and the Ollama model name.
CHAT_PROVIDER=mock
CHAT_MODEL=gpt-4o-mini
CHAT_TIMEOUT_SECONDS=60
CHAT_HISTORY_LIMIT=20
# Answer levels: CHAT_MODEL is the "Standart" model. Empty level models
# fall back to CHAT_MODEL. Basit also sends less history and asks for a
# short answer; Kapsamlı asks for a detailed one.
CHAT_MODEL_BASIC=
CHAT_MODEL_DEEP=
# CHAT_MAX_TOKENS_* cap each reply (positive integers). For reasoning models
# the cap also counts hidden reasoning tokens, so set it higher for those
# models; a reply that hits the cap is flagged as cut off.
CHAT_MAX_TOKENS_BASIC=500
CHAT_MAX_TOKENS_STANDARD=1500
CHAT_MAX_TOKENS_DEEP=4000
CHAT_HISTORY_LIMIT_BASIC=6
# The level is chosen automatically: each question is first classified by
# the Basit model (a few hundred tokens). CHAT_AUTO_LEVEL=false sends every
# question at Standart and skips the classification call.
CHAT_AUTO_LEVEL=true
CHAT_CLASSIFIER_TIMEOUT_SECONDS=8

DATABASE_URL=sqlite:///./casebridge.db
JWT_SECRET=change-me-in-dev
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ENV=development
